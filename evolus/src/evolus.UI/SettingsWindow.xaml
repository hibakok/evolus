<Window x:Class="evolus.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки эволюции" Height="400" Width="450"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Размер популяции:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtPopulationSize" Margin="0,0,0,15"/>

            <TextBlock Text="Потомков на особь:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtOffspringPerIndividual" Margin="0,0,0,15"/>

            <TextBlock Text="Мутаций на потомка:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtMutationsPerOffspring" Margin="0,0,0,15"/>

            <TextBlock Text="Максимум поколений:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtMaxGenerations" Margin="0,0,0,15"/>

            <TextBlock Text="Случайное зерно (Random Seed):" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtRandomSeed" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Height="30" Margin="0,0,10,0" Click="BtnOk_Click"/>
            <Button Content="Отмена" Width="80" Height="30" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
